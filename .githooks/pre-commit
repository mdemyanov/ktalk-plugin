#!/usr/bin/env bash
# Git pre-commit hook — сканирует staged-diff на секреты (ADR-040 Д1, secret-hygiene-gate),
# затем запускает scripts/check.sh --fast.
# Активация: bash scripts/install-hooks.sh (или git config core.hooksPath .githooks)
# Bypass: git commit --no-verify

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- secret scan, staged diff (ADR-040-spec §1.3/§4) — ДО check.sh, вставка идёт ВЫШЕ exec
# ниже (замер: пустой commit git не создаёт вовсе — "нечего проверять", не "чисто"; отдельный
# вызов из CI по пустому индексу не должен выглядеть как успешное сканирование, §8 edge case).
#
# Провенанс нормы (У-5 ADR-043 Д3, прецедент `limit_source: default` ADR-036 Д3): значения
# enabled/binary при отсутствии ключа `secretScan` берутся ИЗ КОДА, и хук обязан назвать не
# только использованное значение, но и его происхождение. Строка печатается ДО сканирования —
# на упавшем сканере её иначе не увидеть.
GATES_FILE="$REPO_ROOT/.nauta-gates.yaml"
SECRET_SCAN_ENABLED=true
SECRET_SCAN_BINARY=gitleaks
SECRET_SCAN_SOURCE="default (умолчание в коде .githooks/pre-commit; ключ secretScan в .nauta-gates.yaml не задан)"
if [[ -f "$GATES_FILE" ]]; then
  _v="$(awk '
    /^secretScan:[ \t]*(#.*)?$/ { inblk=1; next }
    inblk && $0 ~ /^[^ \t]/ { inblk=0 }
    inblk && $0 ~ /^[ \t]*enabled:/ {
      line=$0; sub(/^[ \t]*enabled:[ \t]*/, "", line)
      gsub(/[ \t]+$/, "", line); gsub(/^"/, "", line); gsub(/"$/, "", line)
      print line; exit
    }
  ' "$GATES_FILE")"
  if [[ -n "$_v" ]]; then
    SECRET_SCAN_ENABLED="$_v"
    SECRET_SCAN_SOURCE="configured (.nauta-gates.yaml, ключ secretScan)"
  fi
  _b="$(awk '
    /^secretScan:[ \t]*(#.*)?$/ { inblk=1; next }
    inblk && $0 ~ /^[^ \t]/ { inblk=0 }
    inblk && $0 ~ /^[ \t]*binary:/ {
      line=$0; sub(/^[ \t]*binary:[ \t]*/, "", line)
      gsub(/[ \t]+$/, "", line); gsub(/^"/, "", line); gsub(/"$/, "", line)
      print line; exit
    }
  ' "$GATES_FILE")"
  if [[ -n "$_b" ]]; then
    SECRET_SCAN_BINARY="$_b"
    SECRET_SCAN_SOURCE="configured (.nauta-gates.yaml, ключ secretScan)"
  fi
fi

echo "секретное сканирование (secretScan): enabled=$SECRET_SCAN_ENABLED, binary=$SECRET_SCAN_BINARY — норма: $SECRET_SCAN_SOURCE"

if [[ "$SECRET_SCAN_ENABLED" == "true" ]]; then
  if ! command -v "$SECRET_SCAN_BINARY" >/dev/null 2>&1; then
    echo "ERROR: '$SECRET_SCAN_BINARY' не найден в PATH — сканирование секретов staged-diff не" >&2
    echo "выполнено, commit заблокирован (это НЕ \"нет находок\" — ADR-007 Д1). Установи:" >&2
    echo "brew install gitleaks (замер §1.1 ADR-040-spec)." >&2
    exit 1
  fi
  if ! "$SECRET_SCAN_BINARY" git --staged --redact --no-banner -v . 2>&1; then
    echo "ERROR: secret-hygiene-gate — commit заблокирован (см. находки $SECRET_SCAN_BINARY выше)." >&2
    exit 1
  fi
fi

if [[ ! -f scripts/check.sh ]]; then
  echo "WARNING: scripts/check.sh не найден; pre-commit skipped" >&2
  exit 0
fi

exec bash scripts/check.sh --fast
